---
import "@fontsource-variable/fraunces";
import "@fontsource/karla/400.css";
import "@fontsource/karla/700.css";
import "../styles/global.css";
import { site } from "../config/site.js";

// BASE_URL llega sin "/" final cuando hay `base` configurada; normalizamos.
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(base, Astro.site);
const ogImage = site.seo.ogImage
  ? new URL(`${base}${site.seo.ogImage}`, Astro.site)
  : null;

// Datos estructurados para Google (panel local, resultados enriquecidos).
const openingHours = site.hours.map((h) => h.schema).filter(Boolean);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Physician",
  name: site.doctor.name,
  medicalSpecialty: site.seo.medicalSpecialty,
  description: site.seo.description,
  url: canonical.href,
  telephone: `+${site.contact.phoneE164}`,
  email: site.contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.contact.address,
  },
  ...(openingHours.length > 0 && { openingHours }),
  ...(ogImage && { image: ogImage.href }),
};

const socialLinks = Object.values(site.social).filter(Boolean);
if (socialLinks.length > 0) jsonLd.sameAs = socialLinks;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mismo valor que --paper en src/styles/global.css (barra del navegador móvil) -->
    <meta name="theme-color" content="#faf6f1" />
    <!-- Marca que hay JS disponible: las animaciones de entrada (.reveal) solo
         ocultan contenido si esta clase existe; sin JS todo queda visible. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <title>{site.seo.title}</title>
    <meta name="description" content={site.seo.description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.doctor.name} />
    <meta property="og:title" content={site.seo.title} />
    <meta property="og:description" content={site.seo.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={site.seo.locale} />
    {ogImage && <meta property="og:image" content={ogImage.href} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={site.seo.title} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.seo.title} />
    <meta name="twitter:description" content={site.seo.description} />
    {ogImage && <meta name="twitter:image" content={ogImage.href} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />

    <script>
      // Revela las secciones al entrar en pantalla (mejora progresiva:
      // sin JS todo es visible; con reduced-motion no hay animación).
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      const targets = document.querySelectorAll(".reveal");
      if (reduced.matches || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
