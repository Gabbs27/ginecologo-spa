---
import { site } from "../config/site.js";
---

<section id="sobre-mi" class="section">
  <div class="container about-grid">
    <div class="reveal">
      <p class="eyebrow">{site.sections.about}</p>
      <h2>{site.doctor.name}</h2>
      <p class="about-intro">{site.doctor.intro}</p>
    </div>

    <ul class="credentials reveal" style="--reveal-delay: 0.15s">
      {
        site.doctor.credentials.map((credential) => (
          <li>{credential}</li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  h2 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-block: 0.65rem 1.25rem;
  }

  .about-intro {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: "opsz" 28;
    font-size: 1.3rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .credentials {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .credentials li {
    position: relative;
    padding: 1.1rem 1.4rem 1.1rem 2.4rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    font-weight: 700;
    font-size: 0.98rem;
  }

  .credentials li::before {
    content: "";
    position: absolute;
    left: 1.1rem;
    top: 1.65rem;
    width: 0.7rem;
    height: 2px;
    background: var(--rose-deep);
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
